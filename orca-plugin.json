{
  "manifestVersion": 2,
  "id": "capture-studio",
  "name": "Capture Studio",
  "version": "0.2.0",
  "description": "Capture code or a conversation directly over your Orca window. Preview whole-window screenshots with detected chat and editor panes blurred on macOS.",
  "repository": "https://github.com/BautistaPessagno/orca-capture",
  "author": {
    "name": "Bautista Pessagno"
  },
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "main": "worker.mjs",
  "capabilities": [],
  "contributes": {
    "commands": [
      {
        "id": "capture-excerpt",
        "title": "Capture Studio: Screenshot Excerpt"
      },
      {
        "id": "capture-window",
        "title": "Capture Studio: Screenshot Orca Window"
      }
    ],
    "keybindings": [
      {
        "command": "capture-excerpt",
        "key": "Mod+Alt+Shift+C"
      },
      {
        "command": "capture-window",
        "key": "Mod+Alt+Shift+B"
      }
    ]
  }
}
